{
  "name": "jsx-dom-runtime",
  "version": "0.84.0",
  "description": "A tiny 500-byte library for JSX templates targeting the DOM. Supports HTML, SVG, MathML, and Custom Element tags",
  "type": "module",
  "main": "jsx-runtime/index.js",
  "module": "jsx-runtime/index.js",
  "types": "./index.d.ts",
  "packageManager": "^npm@11.4.2",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./jsx-runtime/index.js"
    },
    "./jsx-runtime": {
      "types": "./index.d.ts",
      "import": "./jsx-runtime/index.js"
    },
    "./babel-preset": "./babel-preset/index.js",
    "./eslint-plugin": "./eslint-plugin/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src tests",
    "test": "vitest run",
    "build": "rolldown -c",
    "size": "size-limit",
    "types": "tsc --project tests/tsconfig.json"
  },
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/helper-validator-identifier": "^8.0.0",
    "@babel/types": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@babel/helper-validator-identifier": {
      "optional": true
    },
    "@babel/types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/helper-validator-identifier": "^8.0.4",
    "@babel/types": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "rolldown": "^1.2.5",
    "size-limit": "^13.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "AGENTS.md",
    "babel-preset",
    "eslint-plugin",
    "jsx-runtime",
    "index.d.ts"
  ],
  "keywords": [
    "jsx",
    "jsx-dom",
    "jsx-runtime",
    "babel-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shoonia/jsx-dom-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/shoonia/jsx-dom-runtime/issues"
  },
  "author": {
    "name": "Alexander Zaytsev",
    "email": "zaytsev126@gmail.com",
    "url": "https://x.com/_shoonia"
  },
  "homepage": "https://github.com/shoonia/jsx-dom-runtime",
  "license": "MIT"
}
